# --- Secrets: fill these in ---
# W&B / Forge API key: used for Weave, Registry, Serverless Inference, Serverless RL, and CPU Sandboxes.
WANDB_API_KEY=
# gpt-6.1-sol backend, using OpenAI Responses with image inputs.
OPENAI_API_KEY=

# --- Forge team and project ---
# Must be the team entity: Serverless Inference rejects calls made under a personal entity.
WANDB_ENTITY=wg-fc-infra-workshops
WANDB_PROJECT=bufo-gen

# --- Models ---
INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
OPEN_MODEL=google/gemma-4-26B-A4B-it
# Set to a wandb-artifact:///wg-fc-infra-workshops/bufo-gen/<lora-name>:<alias> model string once a tuned LoRA exists.
OPEN_TUNED_MODEL=
# Base ID used for the ft- display label; keep this aligned with adapter lineage.
OPEN_TUNED_BASE_MODEL=google/gemma-4-26B-A4B-it
OPENAI_BASE_URL=https://api.openai.com/v1
SOL_MODEL=gpt-6.1-sol
# Shared web-context tool for every drawing model. Uses OPENAI_API_KEY above.
BUFO_WEB_SEARCH=true
BUFO_SEARCH_MODEL=gpt-6.1-sol
# VLM judge: Serverless Inference model ID from docs.coreweave.com/products/inference/serverless/models, served at INFERENCE_BASE_URL.
JUDGE_MODEL=Qwen/Qwen3.8-27B
# Scene-quality scorer: open_base (CoreWeave Chat Completions) or closed_quality_bar
# (gpt-6.1-sol/OpenAI Responses). Defaults to open_base; choosing gpt-6.1-sol needs OPENAI_API_KEY.
SCENE_JUDGE_BACKEND=open_base
# Optional scene-only model override. Empty uses JUDGE_MODEL for open_base or SOL_MODEL
# for closed_quality_bar. Backend/rubric changes require new scores and calibration evidence.
SCENE_JUDGE_MODEL=

# Optional for CPU serverless rendering; required for GPU SFT. All use cwsandbox directly.
CWSANDBOX_API_KEY=
# Needed if the google/gemma-4-26B-A4B-it weights require a Hugging Face license acceptance/token.
HF_TOKEN=
# Build and push scripts/train_entrypoints/Dockerfile to your container registry.
BUFO_SFT_IMAGE=
BUFO_SFT_TIMEOUT=7200
# Optional prebuilt Python + resvg-py==0.5.0 image. Default uploads a Linux wheel
# to python:3.12-slim, with all render-sandbox network egress denied.
BUFO_RENDER_IMAGE=
# Create this Registry once in your W&B organization; collections are linked here.
WANDB_REGISTRY=Bufo Forge

# Managed Model Distillation uses the explicit entity above and an existing project alias.
# Import/publish project routing only as an explicit setup action.
FORGE_PROJECT_ALIAS=bufo-gen
FORGE_BASE_URL=https://forge.coreweave.com/api/distillation/v1
FORGE_TRAINING_BASE_URL=https://forge.coreweave.com/api/training/v1
FORGE_STATE_PATH=runs/forge-loop/forge-state.json
# Managed SFT is the primary path; BUFO_SFT_IMAGE applies only to the legacy sandbox trainer.
