!runs/distill/stage-b/checkpoints.json
wandb/
*.wandb
data/
artifacts/
.art/
.cache/
*.log

# Documentation contains tested experiment tools; keep it versioned.
# Exclude local source backups and generated recording files instead.
docs/**/before/
docs/**/*-before/
demo/**/edit/
demo/**/qa/
demo/**/*.mov
demo/**/*.mp4
demo/**/*.aiff
demo/**/*.progress
demo/**/capture-*.json

